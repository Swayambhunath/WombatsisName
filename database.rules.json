{
  "rules": {
    ".read": false,
    ".write": false,
    "votes": {
      "$who": {
        ".read": "auth != null && (auth.token.email === 'vroni@namenswipe.invalid' || auth.token.email === 'felix@namenswipe.invalid')",
        ".write": "auth != null && (($who === 'vroni' && auth.token.email === 'vroni@namenswipe.invalid') || ($who === 'felix' && auth.token.email === 'felix@namenswipe.invalid'))",
        "$name": {
          ".validate": "$name.length <= 40 && (newData.val() === 1 || newData.val() === 2)"
        }
      }
    }
  }
}